TEXT 136 392 Left 2 !.param Ff=7200k\n.param T_int={200/Ff}\n.param rload=50\n.param cshunt=425p\n.param ctank=576p\n.param ltank=1.1u\n.meas tran re1 AVG V(out)*cos(360*Ff*time) FROM 200u TO {200u+T_int}\n.meas tran im1 AVG V(out)*sin(360*Ff*time) FROM 200u TO {200u+T_int}\n.meas tran h1 PARAM 2*sqrt(re1**2+im1**2)\n.meas tran re2 AVG V(out)*cos(360*2*Ff*time) FROM 200u TO {200u+T_int}\n.meas tran im2 AVG V(out)*sin(360*2*Ff*time) FROM 200u TO {200u+T_int}\n.meas tran h2 PARAM 2*sqrt(re2**2+im2**2)\n.meas tran re3 AVG V(out)*cos(360*3*Ff*time) FROM 200u TO {200u+T_int}\n.meas tran im3 AVG V(out)*sin(360*3*Ff*time) FROM 200u TO {200u+T_int}\n.meas tran h3 PARAM 2*sqrt(re3**2+im3**2)\n.meas tran H2_down PARAM 20*log10(h2/h1)\n.meas tran H3_down PARAM 20*log10(h3/h1)\n.meas tran Pin_Watts AVG -V(dcin)*I(V1) FROM 200u TO {200u+T_int}\n.meas tran Pout_Watts AVG V(out)**2/{rload} FROM 200u TO {200u+T_int}\n.meas tran System_Eff PARAM (Pout_Watts/Pin_Watts)*100\n.meas tran Pwatt_fundamental PARAM (h1**2)/(2*rload)\n.tran 0 {200u + T_int} 0 1n\n.four 7200k V(out)\n.four 7200k I(R1)\n \n.meas tran Pswitch AVG V(drain)*Id(M1) FROM 200u TO {200u+T_int}\n \n.meas tran Switch_Loss_Pct PARAM (Pswitch/Pin_Watts)*100
